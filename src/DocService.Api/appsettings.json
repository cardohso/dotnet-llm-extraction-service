{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "OpenAiCompatible",
    "BaseUrl": "https://api.groq.com/openai/v1/",
    "Model": "openai/gpt-oss-20b",
    "ReasoningEffort": "low",
    "Pricing": {
      "InputPerMillionUsd": 0,
      "OutputPerMillionUsd": 0
    },
    "Resilience": {
      "TotalRequestTimeout": {
        "Timeout": "00:00:30"
      },
      "AttemptTimeout": {
        "Timeout": "00:00:10"
      },
      "Retry": {
        "MaxRetryAttempts": 2,
        "Delay": "00:00:00.500"
      },
      "CircuitBreaker": {
        "FailureRatio": 0.5,
        "SamplingDuration": "00:00:30",
        "MinimumThroughput": 5,
        "BreakDuration": "00:00:30"
      }
    }
  },
  "Processing": {
    "MaxInputChars": 20000,
    "TokenBudgetPerRequest": 16000,
    "ExtractMaxOutputTokens": 800,
    "SummariseMaxOutputTokens": 600,
    "MaxSentences": 200
  },
  "RateLimiting": {
    "TokenLimit": 5,
    "TokensPerPeriod": 1,
    "ReplenishmentSeconds": 3,
    "ConcurrencyLimit": 4,
    "QueueLimit": 10
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 262144
    }
  }
}
